# Supabase (auth + database). Optional — without these the app opens locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (chat + Gmail proposal extraction). OPENAI_MODEL defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Composio (Google Calendar, Gmail, Slack, Notion, WHOOP, Fitbit, Strava, Oura).
# Apple Health and Apple Calendar connect natively on iOS — no Composio key needed.
COMPOSIO_API_KEY=
# The Composio entity that owns your connected accounts.
COMPOSIO_USER_ID=tempo-user
