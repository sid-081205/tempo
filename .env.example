# Supabase (auth + database). Without these the app runs in demo mode: no
# auth wall, a stand-in user, everything else fully functional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (chat). Without a key, chat answers from a built-in engine grounded
# in the demo data. OPENAI_MODEL defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Composio (real connectors: Google Calendar, Gmail, Slack, Notion, WHOOP,
# Fitbit, Strava). Without a key, connectors show as "Needs setup" and the
# calendar uses sample data.
COMPOSIO_API_KEY=
# The Composio entity that owns your connected accounts.
COMPOSIO_USER_ID=tempo-user
