{
  "name": "Tempo / Butter × Blue",
  "font": {
    "family": "Space Grotesk",
    "source": "Google Fonts",
    "weights": [300, 400, 500, 600, 700],
    "fallback": "system-ui, sans-serif"
  },
  "colors": {
    "paper": { "hsl": "hsl(55 42% 93%)", "hex": "#F5F3E6" },
    "paperDeep": { "hsl": "hsl(55 36% 87%)", "hex": "#EAE8D2" },
    "ink": { "hsl": "hsl(55 24% 15%)", "hex": "#2F2E1D" },
    "muted": { "hsl": "hsl(55 12% 52%)", "hex": "#939176" },
    "accent": { "hsl": "hsl(228 52% 46%)", "hex": "#3851B2" },
    "accentDeep": { "hsl": "hsl(228 54% 36%)", "hex": "#2A3E8D" },
    "card": { "hsl": "hsl(55 45% 97%)", "hex": "#FBFAF4" },
    "line": { "hsl": "hsl(55 24% 83%)", "hex": "#DEDCC9" },
    "phoneGradientStart": { "hsl": "hsl(228 55% 84%)", "hex": "#C0C9ED" },
    "phoneGradientEnd": { "hsl": "hsl(228 50% 68%)", "hex": "#8595D6" },
    "error": { "hex": "#A8506A" },
    "blobA": { "hsl": "hsl(228 62% 70% / 0.45)", "hex": "#8396E2", "alpha": 0.45 },
    "blobB": { "hsl": "hsl(260 55% 62% / 0.32)", "hex": "#8C69D3", "alpha": 0.32 },
    "blobC": { "hsl": "hsl(55 60% 82% / 0.6)", "hex": "#EDE8B6", "alpha": 0.6 }
  },
  "glass": {
    "background": "rgba(255,255,255,0.4)",
    "border": "1px solid rgba(255,255,255,0.55)",
    "backdropBlur": "16px"
  },
  "radii": {
    "button": "9999px",
    "notificationCard": "24px",
    "iconTile": "10px",
    "phoneFrame": "51px"
  },
  "motion": {
    "entrance": { "duration": "0.8s", "easing": "cubic-bezier(0.22, 1, 0.36, 1)", "rise": "22px", "stagger": "130ms" },
    "notificationSpring": { "duration": "0.75s", "easing": "cubic-bezier(0.34, 1.4, 0.44, 1)" },
    "notificationInterval": "4.2s",
    "marquee": { "duration": "30s", "gap": "4.5rem" },
    "blobDrift": ["26s", "32s", "38s"],
    "phoneFloat": "7s"
  }
}
